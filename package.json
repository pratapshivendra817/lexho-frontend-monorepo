{
  "name": "lexho-frontend-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "admin": "npm run dev:admin",
    "customer": "npm run mobile:customer",
    "partner": "npm run mobile:partner",
    "dev": "npm run dev:admin",
    "dev:admin": "npm run dev --workspace=@lexho/admin",
    "dev:website": "npm run dev --workspace=@lexho/website",
    "dev:customer:mobile": "npm run start --prefix apps/customer/legacy-mobile -- --reset-cache",
    "dev:partner:mobile": "npm run start --prefix apps/partner/legacy-mobile -- --reset-cache",
    "mobile:customer": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-android.ps1 -App customer",
    "mobile:partner": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-android.ps1 -App partner",
    "mobile:both": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-android.ps1 -App both",
    "mobile:emulators": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-emulators.ps1",
    "mobile:emulator:customer": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-emulators.ps1 -App customer",
    "mobile:emulator:partner": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-emulators.ps1 -App partner",
    "android:customer": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-android.ps1 -App customer",
    "android:partner": "powershell -ExecutionPolicy Bypass -File scripts/run-rn-android.ps1 -App partner",
    "migrate:image-paths:dry": "node scripts/fix-admin-image-paths.mjs",
    "migrate:image-paths:apply": "node scripts/fix-admin-image-paths.mjs --apply",
    "build:admin": "npm run build --workspace=@lexho/admin",
    "build:website": "npm run build --workspace=@lexho/website",
    "build": "npm run build:admin",
    "lint:admin": "npm run lint --workspace=@lexho/admin",
    "lint:website": "npm run lint --workspace=@lexho/website",
    "preview:admin": "npm run preview --workspace=@lexho/admin",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "typescript": "~6.0.2"
  }
}
