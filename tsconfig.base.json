{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@lexho/ui": ["packages/ui/src"],
      "@lexho/api": ["packages/api/src"],
      "@lexho/auth": ["packages/auth/src"],
      "@lexho/constants": ["packages/constants/src"],
      "@lexho/hooks": ["packages/hooks/src"],
      "@lexho/utils": ["packages/utils/src"]
    }
  }
}
